pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hariharan1112/student-frontend'
        SERVICE_NAME = 'student-frontend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                        -t ${IMAGE_NAME}:latest \
                        .
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Docker Swarm') {
            steps {
                sh '''
                    if docker service inspect ${SERVICE_NAME} >/dev/null 2>&1; then

                        echo "Updating existing Swarm service..."

                        docker service update \
                            --image ${IMAGE_NAME}:${BUILD_NUMBER} \
                            --update-parallelism 1 \
                            --update-delay 5s \
                            --update-order start-first \
                            ${SERVICE_NAME}

                    else

                        echo "Creating new Swarm service..."

                        docker service create \
                            --name ${SERVICE_NAME} \
                            --publish published=80,target=80 \
                            --replicas 1 \
                            ${IMAGE_NAME}:${BUILD_NUMBER}

                    fi
                '''
            }
        }

        stage('Check Swarm Service') {
            steps {
                sh '''
                    echo "Swarm services:"
                    docker service ls

                    echo "Frontend service:"
                    docker service ps ${SERVICE_NAME}
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "Waiting for frontend..."
                    sleep 10

                    curl -f http://localhost/ || exit 1

                    echo "Frontend health check successful!"
                '''
            }
        }
    }

    post {

        success {
            echo 'Frontend successfully built, pushed and deployed to Docker Swarm!'
        }

        failure {
            echo 'Frontend deployment failed!'
        }
    }
}